# Configuration de l'API
# URL de base pour les appels API - utilisé en priorité
VITE_API_BASE_URL=http://localhost:8000

# Alternative à VITE_API_BASE_URL (pour compatibilité)
# VITE_API_URL=http://localhost:8000

# Configuration Sentry (optionnel)
# DSN pour le monitoring des erreurs en production
# Si non défini, Sentry sera désactivé
VITE_SENTRY_DSN=

# Configuration Analytics (optionnel)
# ID pour Google Analytics ou autre service d'analytics
# Si non défini, l'analytics sera désactivé
VITE_ANALYTICS_ID=

# Autres variables d'environnement (à adapter selon vos besoins)
# VITE_APP_NAME=Pi Staking
# VITE_APP_VERSION=1.0.0

# Variables pour le développement local
# Ces variables sont automatiquement définies par Vite
# DEV=true (en mode développement)
# PROD=false (en mode développement)